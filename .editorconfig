root = true

[*]
end_of_line = lf
insert_final_newline = true

[java]
indent_style = space
indent_size = 4

[pom.xml]
indent_style = space
indent_size = 4

[*.mustache]
indent_style = space
indent_size = 4
insert_final_newline = false

[*.yml]
indent_style = space
indent_size = 2
insert_final_newline = false