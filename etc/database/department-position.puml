@startuml
' SQL-style ER diagram for Department and Position (database tables)
entity "SCOS_DEPARTMENT" as SCOS_DEPARTMENT {
  * DEPARTMENT_ID : BIGINT <<PK>>
  --
  CODE : VARCHAR(30) <<NOT NULL, UNIQUE>>
  DESCRIPTION : VARCHAR(500) <<NOT NULL>>
  ACTIVE : BOOLEAN NOT NULL DEFAULT TRUE
  CREATED_AT : LocalDateTime
  UPDATED_AT : LocalDateTime
  USER_AT : VARCHAR(100)
}

entity "SCOS_POSITION" as SCOS_POSITION {
  * POSITION_ID : BIGINT <<PK>>
  --
  CODE : VARCHAR(30) <<NOT NULL, UNIQUE>>
  DESCRIPTION : VARCHAR(500) <<NOT NULL>>
  ACTIVE : BOOLEAN NOT NULL DEFAULT TRUE
  DEPARTMENT_ID : BIGINT <<NOT NULL, FK -> SCOS_DEPARTMENT.DEPARTMENT_ID>>
  CREATED_AT : LocalDateTime
  UPDATED_AT : LocalDateTime
  USER_AT : VARCHAR(100)
}

SCOS_DEPARTMENT ||--o{ SCOS_POSITION : "1..* positions"

note right of SCOS_DEPARTMENT
  - Escopo: GLOBAL
  - Constraint: UNIQUE(CODE)
end note
@enduml