@startuml
' SQL-style ER diagram for Login & Profile (database tables)
entity "SCOS_PROFILE" as SCOS_PROFILE {
  * PROFILE_ID : BIGINT <<PK>>
  --
  CODE : VARCHAR(50) <<NOT NULL, UNIQUE>>
  DESCRIPTION : VARCHAR(250)
  ACTIVE : BOOLEAN
  FEATURES : TEXT[]
  CREATED_AT : LocalDateTime
  UPDATED_AT : LocalDateTime
  USER_AT : VARCHAR(100)
}

entity "SCOS_LOGIN" as SCOS_LOGIN {
  * LOGIN_ID : BIGINT <<PK>>
  --
  KEYCLOAK_ID : UUID
  LOGIN : VARCHAR(255) <<NOT NULL, UNIQUE>>
  PASSWORD : VARCHAR(255)
  SALT : VARCHAR(255)
  STATUS : VARCHAR(50)
  DATE_CREATED : DATE
  DATE_LAST_CHANGE_PASSWORD : DATE
  PROFILE_ID : BIGINT <<FK -> SCOS_PROFILE.PROFILE_ID>>
  EMPLOYEE_ID : BIGINT <<FK -> SCOS_EMPLOYEE.EMPLOYEE_ID>>
  CREATED_AT : LocalDateTime
  UPDATED_AT : LocalDateTime
  USER_AT : VARCHAR(100)
}

SCOS_PROFILE ||--o{ SCOS_LOGIN : "1..* logins"
SCOS_EMPLOYEE ||--o{ SCOS_LOGIN : "1..* logins (by employee)"

note right of SCOS_LOGIN
  - STATUS values: ENABLE, BLOCKED, INACTIVE, PENDING, PENDING_PASSWORD_CHANGE
  - PROFILE.features stored as text[] in DB
end note
@enduml