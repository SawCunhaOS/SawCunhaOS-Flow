@startuml
' SQL-style ER diagram for Company aggregate (database tables)
entity "SCOS_COMPANY" as SCOS_COMPANY {
  * COMPANY_ID : BIGINT <<PK>>
  --
  NAME : VARCHAR(250) <<NOT NULL>>
  NAME_TREATMENT : VARCHAR(250)
  TAX_IDENTIFIER : VARCHAR(20) -- CNPJ
  FOUNDATION_DATE : DATE
  SECTOR_OF_ACTIVITY : VARCHAR(100)
  OBSERVATION : TEXT
  DATE_CREATED : DATE
  STATUS : VARCHAR(20) -- ACTIVE / INACTIVE / DISABLED
  ACTIVE : BOOLEAN
  PARENT_COMPANY_ID : BIGINT <<FK -> SCOS_COMPANY.COMPANY_ID>>
  CREATED_AT : LocalDateTime
  UPDATED_AT : LocalDateTime
  USER_AT : VARCHAR(100)
}

entity "SCOS_COMPANY_CONTACT" as SCOS_COMPANY_CONTACT {
  * CONTACT_ID : BIGINT <<PK>>
  --
  RESPONSIBLE_PERSON : VARCHAR(250)
  TYPE : VARCHAR(50)
  EMAIL : VARCHAR(255)
  PHONE : VARCHAR(50)
  COMPANY_ID : BIGINT <<FK -> SCOS_COMPANY.COMPANY_ID>>
  CREATED_AT : LocalDateTime
  UPDATED_AT : LocalDateTime
  USER_AT : VARCHAR(100)
}

entity "SCOS_COMPANY_ADDRESS" as SCOS_COMPANY_ADDRESS {
  * COMPANY_ID : BIGINT <<PK>>
  * ADDRESS_ID : BIGINT <<PK>>
  --
  TYPE : VARCHAR(50)
  NUMBER : BIGINT
  COMPLEMENT : VARCHAR(250)
  GEOLOCATION : GEOMETRY(POINT)
  CREATED_AT : LocalDateTime
  UPDATED_AT : LocalDateTime
  USER_AT : VARCHAR(100)
}

SCOS_COMPANY ||--o{ SCOS_COMPANY_CONTACT : "1..* contacts"
SCOS_COMPANY ||--o{ SCOS_COMPANY_ADDRESS : "1..* addresses"
SCOS_COMPANY }o--|| SCOS_COMPANY : "parentCompany (FK)"

note right of SCOS_COMPANY_ADDRESS
  CompanyAddress uses an embedded PK (COMPANY_ID, ADDRESS_ID)
end note
@enduml