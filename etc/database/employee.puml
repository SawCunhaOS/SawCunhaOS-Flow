@startuml
' SQL-style ER diagram for Employee aggregate (database tables)
entity "SCOS_EMPLOYEE" as SCOS_EMPLOYEE {
  * EMPLOYEE_ID : BIGINT <<PK>>
  --
  NAME : VARCHAR(250) <<NOT NULL>>
  NAME_TREATMENT : VARCHAR(100)
  TAX_IDENTIFIER : VARCHAR(20) -- CPF
  EMAIL : VARCHAR(255)
  BIRTH_DATE : DATE
  DATE_OF_HIRING : DATE
  OBSERVATION : TEXT
  DATE_CREATED : DATE
  ACTIVE : BOOLEAN
  SUPERVISOR_ID : BIGINT <<FK -> SCOS_EMPLOYEE.EMPLOYEE_ID>>
  POSITION_ID : BIGINT <<FK -> SCOS_POSITION.POSITION_ID>>
  COMPANY_ID : BIGINT <<FK -> SCOS_COMPANY.COMPANY_ID>>
  CREATED_AT : LocalDateTime
  UPDATED_AT : LocalDateTime
  USER_AT : VARCHAR(100)
}

entity "SCOS_EMPLOYEE_CONTACT" as SCOS_EMPLOYEE_CONTACT {
  * CONTACT_ID : BIGINT <<PK>>
  --
  TYPE : VARCHAR(50)
  PHONE : VARCHAR(50)
  EMPLOYEE_ID : BIGINT <<FK -> SCOS_EMPLOYEE.EMPLOYEE_ID>>
  CREATED_AT : LocalDateTime
  UPDATED_AT : LocalDateTime
  USER_AT : VARCHAR(100)
}

entity "SCOS_EMPLOYEE_ADDRESS" as SCOS_EMPLOYEE_ADDRESS {
  * EMPLOYEE_ID : BIGINT <<PK>>
  * ADDRESS_ID : BIGINT <<PK>>
  --
  TYPE : VARCHAR(50)
  NUMBER : BIGINT
  COMPLEMENT : VARCHAR(250)
  GEOLOCATION : GEOMETRY(POINT)
  CREATED_AT : LocalDateTime
  UPDATED_AT : LocalDateTime
  USER_AT : VARCHAR(100)
} 

SCOS_EMPLOYEE ||--o{ SCOS_EMPLOYEE_CONTACT : "1..* contacts"
SCOS_EMPLOYEE ||--o{ SCOS_EMPLOYEE_ADDRESS : "1..* addresses"
SCOS_EMPLOYEE ||--o{ SCOS_EMPLOYEE : "supervisor (self-FK)" #line:grey
SCOS_EMPLOYEE }o--|| SCOS_POSITION : "positionId (FK)"
SCOS_EMPLOYEE }o--|| SCOS_COMPANY : "companyId (FK)"

note right of SCOS_EMPLOYEE
  - Position é GLOBAL e valida regras do Employee
  - supervisor é self-reference (SUPERVISOR_ID → SCOS_EMPLOYEE.EMPLOYEE_ID)
end note
@enduml