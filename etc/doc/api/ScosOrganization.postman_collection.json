		{
			"name": "Login Keycloak",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Verifica se a requisição foi bem-sucedida\r",
							"if (pm.response.code === 200) {\r",
							"    var jsonResponse = pm.response.json();\r",
							"    // Acessa o valor do 'access_token' na resposta\r",
							"    var accessToken = jsonResponse.access_token;\r",
							"\r",
							"    // Armazena o token na variável de ambiente (pode ser global também)\r",
							"    pm.collectionVariables.set(\"access_token\", accessToken);\r",
							"\r",
							"    // (Opcional) Exibe o token no console para verificação\r",
							"    console.log(\"Token obtido:\", accessToken);\r",
							"} else {\r",
							"    console.log(\"Falha na requisição, não foi possível obter o token\");\r",
							"}\r",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "urlencoded",
					"urlencoded": [
						{
							"key": "client_id",
							"value": "Scos",
							"type": "text"
						},
						{
							"key": "username",
							"value": "scos-admin",
							"type": "text"
						},
						{
							"key": "password",
							"value": "Api@1234!",
							"type": "text"
						},
						{
							"key": "grant_type",
							"value": "password",
							"type": "text"
						},
						{
							"key": "scope",
							"value": "openid",
							"type": "text"
						}
					]
				},
				"url": {
					"raw": "{{url_keycloak}}/realms/{{realm}}/protocol/openid-connect/token",
					"host": [
						"{{url_keycloak}}"
					],
					"path": [
						"realms",
						"{{realm}}",
						"protocol",
						"openid-connect",
						"token"
					]
				}
			},
			"response": []
		}
