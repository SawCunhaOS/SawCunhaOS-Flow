	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"packages": {},
				"requests": {},
				"exec": [
					"// 1. Busca o valor atual da variável de coleção",
					"let requestId = pm.collectionVariables.get('X-Request-ID');",
					"",
					"// 2. Se estiver nulo ou vazio, gera o UUID e ATUALIZA a variável 'requestId'",
					"if (requestId == null || requestId === \"null\" || requestId === \"\") {",
					"    requestId = pm.variables.replaceIn('{{$randomUUID}}'); // Atualiza a variável local",
					"    pm.collectionVariables.set(\"X-Request-ID\", requestId); // Salva na coleção",
					"    console.log(\"X-Request-ID configurado do zero: \" + requestId);",
					"} else {",
					"    console.log(\"Já existe o X-Request-ID configurado: \" + requestId);",
					"}",
					"",
					"// 3. SE O HEADER NÃO EXISTIR, ADICIONA. SE EXISTIR, ATUALIZA (UPSERT)",
					"// Usamos pm.variables.replaceIn para garantir que ele leia a coleção atualizada se necessário",
					"pm.request.headers.upsert({",
					"    key: 'X-Request-ID',",
					"    value: requestId",
					"});",
					"",
					"console.log(\"Header X-Request-ID injetado na requisição com o valor: \" + requestId);",
					""
				]
			}
		},
