# =============================================================================
# SCOS Organization — exemplo de variáveis de ambiente
# =============================================================================
# Regra geral: NÃO setar nada = comportamento de dev de hoje (regressão-zero).
# Cada valor abaixo é o DEFAULT versionado. Sete apenas o que sua instalação muda.
# Env var é compartilhada entre os módulos boot (HTTP) e grpc-boot (gRPC), exceto
# onde marcado "(só boot)". Onde o default difere por módulo, ambos estão listados.
#
# NÃO são env var (são propriedade Maven no build de imagem, via -D):
#   -Dbp.cds.enabled=false        # fallback do bug paketo #581
#   -Dbp.jvm.thread.count=20      # dimensionar junto do mem_limit do container
#   -Dpaketo.builder=...          # tag/digest do builder (nunca latest)
# =============================================================================

# -----------------------------------------------------------------------------
# ⚠️  SEGREDOS — OBRIGATÓRIO SETAR EM PRODUÇÃO
# -----------------------------------------------------------------------------
# O default abaixo é APENAS de dev e ESTÁ VERSIONADO NO GIT. Em produção, e em
# QUALQUER instalação on-premise por cliente, sete estes valores — não confie no
# default (é o mesmo para todo mundo = risco de segurança multi-cliente).
# Hardening adicional (remover default do git / cifra em repouso via Jasypt) é
# tratado em change separada.
SCOS_DB_USERNAME=scos
SCOS_DB_PASSWORD=scos#2026
SCOS_AUDIT_DB_USERNAME=scos
SCOS_AUDIT_DB_PASSWORD=scos#2026
SCOS_REDIS_PASSWORD=scos#2026
SCOS_REGISTRY_KEY_ACCESS=ABLABLABLA        # (só boot)
SCOS_PRIVACY_CRYPTO_SECRET=ASDASDASDA      # se ligar SCOS_PRIVACY_STRICT=true, este DEVE ser uma chave real

# -----------------------------------------------------------------------------
# TOPOLOGIA — endereços de infra (URL inteira: cobre scheme/porta/db/schema/realm)
# -----------------------------------------------------------------------------
SCOS_DB_URL=jdbc:postgresql://localhost:5432/scos?currentSchema=${SCOS_DB_SCHEMA:scos}
SCOS_AUDIT_DB_URL=jdbc:postgresql://localhost:5432/scos?currentSchema=${SCOS_DB_SCHEMA:scos}
SCOS_DB_SCHEMA=scos                         # knob ÚNICO do schema: alimenta a URL E o default-schema do Liquibase (sempre iguais)
SCOS_KEYCLOAK_ISSUER_URI=http://localhost:7080/realms/Scos   # prod: normalmente https://...
SCOS_REDIS_SENTINELS=localhost:26379                          # HA: h1:26379,h2:26379,h3:26379
SCOS_REGISTRY_HOST=localhost               # (só boot)

# -----------------------------------------------------------------------------
# PORTAS
# -----------------------------------------------------------------------------
SCOS_PORT=8081                             # boot=8081 / grpc-boot=8090
SCOS_REGISTRY_PORT=8090                    # (só boot)
SCOS_REDIS_PORT=26379

# -----------------------------------------------------------------------------
# POOL de conexão — datasource principal (ajustar por tamanho da instalação)
# -----------------------------------------------------------------------------
SCOS_DB_CONN_TIMEOUT=600000
SCOS_DB_IDLE_TIMEOUT=150000
SCOS_DB_MAX_LIFETIME=1800000
SCOS_DB_MIN_IDLE=25                        # ATENÇÃO: manter <= SCOS_DB_MAX_POOL_SIZE (senão HikariCP falha na subida)
SCOS_DB_MAX_POOL_SIZE=100

# -----------------------------------------------------------------------------
# POOL de conexão — datasource de auditoria
# -----------------------------------------------------------------------------
SCOS_AUDIT_DB_CONN_TIMEOUT=100000
SCOS_AUDIT_DB_IDLE_TIMEOUT=150000
SCOS_AUDIT_DB_MAX_LIFETIME=300000
SCOS_AUDIT_DB_MIN_IDLE=10                  # manter <= SCOS_AUDIT_DB_MAX_POOL_SIZE
SCOS_AUDIT_DB_MAX_POOL_SIZE=30

# -----------------------------------------------------------------------------
# TOGGLES operacionais
# -----------------------------------------------------------------------------
SCOS_AUDIT_ENABLED=true
SCOS_CACHE_ENABLE=true                     # boot=true / grpc-boot=false
SCOS_LIQUIBASE_ENABLED=true                # boot=true / grpc-boot=false
SCOS_PRIVACY_ENABLED=true
SCOS_PRIVACY_STRICT=false                  # true exige SCOS_PRIVACY_CRYPTO_SECRET real (senão a app não sobe)
SCOS_JDEMPOTENT_ENABLED=true               # (só boot)
SCOS_REGISTRY_TLS_ENABLED=false            # (só boot) true em produção

# -----------------------------------------------------------------------------
# TUNING fino — cache / jdempotent / privacy (avançado; poucas instalações mudam)
# -----------------------------------------------------------------------------
SCOS_CACHE_TTL=12000000
SCOS_CACHE_DATABASE=0
SCOS_JDEMPOTENT_EXPIRATION_HOUR=2          # (só boot)
SCOS_JDEMPOTENT_DIAL_TIMEOUT_SEC=3         # (só boot)
SCOS_JDEMPOTENT_READ_TIMEOUT_SEC=3         # (só boot)
SCOS_JDEMPOTENT_WRITE_TIMEOUT_SEC=3        # (só boot)
SCOS_JDEMPOTENT_MAX_RETRY=3                # (só boot)
SCOS_JDEMPOTENT_EXPIRE_TIMEOUT_HOUR=3      # (só boot)
SCOS_PRIVACY_MAX_PAYLOAD_KB=64

# -----------------------------------------------------------------------------
# DIAGNÓSTICO JPA / OBSERVABILITY / LOG HTTP
# -----------------------------------------------------------------------------
SCOS_JPA_SHOW_SQL=true                     # prod: RECOMENDADO false (loga todo SQL = perf + PII)
SCOS_JPA_GENERATE_STATISTICS=true          # prod: RECOMENDADO false (custo)
SCOS_JPA_SLOW_QUERY_MS=500
SCOS_TRACING_SAMPLING=1.0                  # prod: RECOMENDADO reduzir (ex 0.1 = 10%)
SCOS_LOG_SHOW_REQUEST_BODY=false           # true expõe corpo da request (mascarado pelo privacy)
SCOS_LOG_SHOW_REQUEST_HEADERS=false
SCOS_LOG_SHOW_RESPONSE_BODY=false

# -----------------------------------------------------------------------------
# TUNING extra (só boot)
# -----------------------------------------------------------------------------
SCOS_REDIS_TIMEOUT=5000ms
SCOS_TOMCAT_MAX_CONNECTIONS=5000
SCOS_TOMCAT_CONNECTION_TIMEOUT=120000

# -----------------------------------------------------------------------------
# LOG — diretório e nível
# -----------------------------------------------------------------------------
LOG_DIR=logs                               # container/on-premise: apontar p/ caminho persistente (ex /var/log/scos)
LOG_LEVEL=INFO                             # prod: WARN; debug pontual: DEBUG
